{
  "name": "companion",
  "private": true,
  "packageManager": "pnpm@11.8.0",
  "type": "module",
  "scripts": {
    "dev:api": "pnpm --filter @companion/api start:dev",
    "dev:mobile": "pnpm --filter @companion/mobile start",
    "build": "pnpm -r --if-present build",
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm -r --if-present test",
    "test:e2e": "pnpm --filter @companion/api test:e2e --runInBand",
    "verify": "pnpm format:check && pnpm lint && pnpm test && pnpm test:e2e && pnpm build",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "3.8.4",
    "prettier-plugin-tailwindcss": "0.8.0"
  }
}
