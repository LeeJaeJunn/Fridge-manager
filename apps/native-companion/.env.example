# Expo는 EXPO_PUBLIC_ 접두사가 붙은 변수만 앱에 노출한다.
# ⚠️ 이 값들은 앱 번들에 박히므로 비밀값(API 키 등)을 넣지 말 것.

# 백엔드(nest) 베이스 URL
# - iOS 시뮬레이터 / Expo 웹: http://localhost:4000
# - 안드로이드 에뮬레이터: http://10.0.2.2:4000
# - 실기기: http://<개발PC의 LAN IP>:4000  (예: http://192.168.0.10:4000)
EXPO_PUBLIC_API_URL=http://localhost:4000
