# OpenAI
OPENAI_API_KEY=sk-...

# Gemini
GEMINI_API_KEY=...

# 서버
PORT=4000

# LLM 모델
LLM_MODEL=gpt-4o-mini

# Naver ocr api 관련
NAVER_OCR_SECRET=...
NAVER_OCR_INVOKE_URL=...

# 인증 — access token(JWT) 서명 secret + 만료, refresh 세션 수명(일)
# JWT_SECRET 은 최소 16자. 프로덕션에서는 반드시 길고 무작위한 값으로 교체할 것.
JWT_SECRET=dev-change-me-to-a-long-random-secret
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=30

# DB — 로컬은 docker-compose.yml 기본값, 프로덕션은 관리형 DB 연결 문자열로 교체
DATABASE_URL="postgresql://companion:companion@localhost:5432/companion?schema=public"

# 네이버 API 사용 클라이언트 ID, seceret
NAVER_CLIENT_ID=...
NAVER_CLIENT_SECRET=...

# 장기 메모리 추출 튜닝 (전부 선택 — 비우면 아래 기본값. 나중에 Settings 테이블로 이전)
# WINDOW  = 추출에 넣을 최근 메시지 수
# EVERY_N = 몇 말풍선(TEXT)마다 추출을 돌릴지
# MODEL   = 추출 전용 모델. 비우면 LLM_MODEL 을 그대로 쓴다(채팅 비용과 분리하고 싶을 때만 지정)
MEMORY_EXTRACT_WINDOW=12
MEMORY_EXTRACT_EVERY_N=6
MEMORY_EXTRACT_MODEL=

# 영수증·사진 스캔 (선택)
# SCAN_MODEL     = 인식 전용 모델. 비우면 LLM_MODEL — 채팅 비용을 안 올리고 인식 모델만 올릴 때 쓴다
# SCAN_DEBUG_DIR = 받은 이미지를 그대로 떨굴 디렉터리. "모델이 못 읽은 건지 이미지가 뭉개진 건지"를
#                  가르는 개발용 스위치다. **프로덕션에서는 반드시 비워 둔다**(사용자 사진이 디스크에 남는다)
SCAN_MODEL=
SCAN_DEBUG_DIR=

# 메일 발송 (선택 — 없으면 이메일 인증만 못 쓰고 서버는 정상 기동)
# Gmail SMTP + 앱 비밀번호(2단계 인증 필요). 개인 계정 말고 **발송 전용 계정**을 권장한다 —
# 앱 비밀번호가 새더라도 개인 메일함이 노출되지 않는다.
# ⚠️ Gmail 은 발송 한도·전달률 때문에 실사용에선 전용 서비스(SES·Resend 등)로 갈아탈 구간이다.
#    그래서 MailService 가 벤더를 감추고 있고, 교체 시 그 파일만 바뀐다.
MAIL_USER=you@gmail.com
# 앱 비밀번호 16자 — 공백을 빼고 붙여넣는다
MAIL_APP_PASSWORD=
MAIL_FROM=Companion <you@gmail.com>
