# OpenAI
OPENAI_API_KEY=sk-...

# Gemini
GEMINI_API_KEY=...

# 서버
PORT=4000

# LLM 모델
LLM_MODEL=gpt-4o-mini

# Naver ocr api 관련
NAVER_OCR_SECRET=...
NAVER_OCR_INVOKE_URL=...

# 인증 — access token(JWT) 서명 secret + 만료, refresh 세션 수명(일)
# JWT_SECRET 은 최소 16자. 프로덕션에서는 반드시 길고 무작위한 값으로 교체할 것.
JWT_SECRET=dev-change-me-to-a-long-random-secret
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=30

# DB — 로컬은 docker-compose.yml 기본값, 프로덕션은 관리형 DB 연결 문자열로 교체
DATABASE_URL="postgresql://companion:companion@localhost:5432/companion?schema=public"

# 네이버 API 사용 클라이언트 ID, seceret
NAVER_CLIENT_ID=...
NAVER_CLIENT_SECRET=...

# 장기 메모리 추출 튜닝 (전부 선택 — 비우면 아래 기본값. 나중에 Settings 테이블로 이전)
# WINDOW  = 추출에 넣을 최근 메시지 수
# EVERY_N = 몇 말풍선(TEXT)마다 추출을 돌릴지
# MODEL   = 추출 전용 모델. 비우면 LLM_MODEL 을 그대로 쓴다(채팅 비용과 분리하고 싶을 때만 지정)
MEMORY_EXTRACT_WINDOW=12
MEMORY_EXTRACT_EVERY_N=6
MEMORY_EXTRACT_MODEL=

# 영수증·사진 스캔 (선택)
# SCAN_MODEL     = 인식 전용 모델. 비우면 LLM_MODEL — 채팅 비용을 안 올리고 인식 모델만 올릴 때 쓴다
# SCAN_DEBUG_DIR = 받은 이미지를 그대로 떨굴 디렉터리. "모델이 못 읽은 건지 이미지가 뭉개진 건지"를
#                  가르는 개발용 스위치다. **프로덕션에서는 반드시 비워 둔다**(사용자 사진이 디스크에 남는다)
SCAN_MODEL=
SCAN_DEBUG_DIR=

# 요리 카드 "만들었어요" → 남은 양 계산 (선택. 비우면 LLM_MODEL)
CONSUME_MODEL=

# 메일 발송 (선택 — 없으면 이메일 인증만 못 쓰고 서버는 정상 기동)
# Gmail SMTP + 앱 비밀번호(2단계 인증 필요). 개인 계정 말고 **발송 전용 계정**을 권장한다 —
# 앱 비밀번호가 새더라도 개인 메일함이 노출되지 않는다.
# ⚠️ Gmail 은 발송 한도·전달률 때문에 실사용에선 전용 서비스(SES·Resend 등)로 갈아탈 구간이다.
#    그래서 MailService 가 벤더를 감추고 있고, 교체 시 그 파일만 바뀐다.
MAIL_USER=you@gmail.com
# 앱 비밀번호 16자 — 공백을 빼고 붙여넣는다
MAIL_APP_PASSWORD=
MAIL_FROM=Companion <you@gmail.com>

# 카카오 로그인 (선택 — 없으면 소셜 로그인만 꺼지고 서버는 정상 기동)
# 콘솔: https://developers.kakao.com
#  - REST API 키   = [앱 키] 탭. 공개돼도 되는 값이지만 서버만 알면 되므로 앱에는 안 넣는다.
#  - CLIENT_SECRET = [보안] 탭에서 발급 + 활성화 '사용함'. 끄면 없어도 동작하지만 켜는 걸 권장한다
#                    (REST API 키만 아는 쪽이 code 를 토큰으로 바꾸지 못하게 하는 한 겹).
#  ⚠️ 어드민 키는 여기 두지 않는다 — 로그인에 안 쓰이고, 유저 강제 탈퇴까지 되는 마스터 키다.
KAKAO_REST_API_KEY=...
KAKAO_CLIENT_SECRET=...

# 카카오가 브라우저를 돌려보낼 **우리 서버** 주소.
# ⚠️ **콘솔에는 여러 개 등록해도 여기엔 지금 쓰는 하나만 넣는다.** 토큰 교환 때 인증 요청과
#    글자까지 같은 값을 보내야 하는데(다르면 KOE006), 서버는 브라우저가 어느 걸 썼는지 알 방법이 없다.
# - 시뮬레이터·웹 : http://localhost:4000/auth/social/kakao/callback
# - 실기기        : http://<개발PC의 LAN IP>:4000/auth/social/kakao/callback
#                   (폰에서 localhost 는 폰 자신이라 절대 안 닿는다 — EXPO_PUBLIC_API_URL 과 같은 사정)
KAKAO_REDIRECT_URI=http://localhost:4000/auth/social/kakao/callback

# 그 콜백이 브라우저를 되돌려 보낼 **앱** 주소.
# ⚠️ 경로가 `login` 인 건 의도다 — 이 딥링크는 앱의 리스너뿐 아니라 **expo-router 에도** 가서,
#    없는 경로면 "Unmatched Route" 화면이 뜬다. 지금 보고 있는 화면을 가리켜야 제자리가 된다.
#    앱이 부팅 시 찍는 `[kakao] ...에 넣을 값` 로그가 정답이다(추측하지 말 것).
# - Expo Go        : exp://<개발PC의 LAN IP>:8081/--/login
# - 빌드된 앱·배포 : nativecompanion://login   (app.json 의 scheme)
# 앱이 목적지를 넘기게 하지 않는 건 의도다 — 그건 오픈 리다이렉트라 인가 코드를 가로챌 수 있다.
# APP_REDIRECT_URL=nativecompanion://login
APP_REDIRECT_URL=exp://localhost:8081/--/login