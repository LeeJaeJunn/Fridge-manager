# OpenAI
OPENAI_API_KEY=sk-...

# 서버
PORT=4000

# LLM 모델
LLM_MODEL=gpt-4o-mini

# 개발용 임시 인증 (회원가입/로그인 붙기 전까지). 프로덕션은 false/미설정.
DEV_AUTH=true
DEV_USER_ID=dev-user

# DB — 로컬은 docker-compose.yml 기본값, 프로덕션은 관리형 DB 연결 문자열로 교체
DATABASE_URL="postgresql://companion:companion@localhost:5432/companion?schema=public"

# 네이버 API 사용 클라이언트 ID, seceret
NAVER_CLIENT_ID=...
NAVER_CLIENT_SECRET=...
