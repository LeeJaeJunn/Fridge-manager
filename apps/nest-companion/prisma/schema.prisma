// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma" // src 안에 둬야 nest build 의 dist 구조가 안 깨짐
  moduleFormat = "cjs" // NestJS는 CommonJS — 기본 ESM(import.meta) 출력은 컴파일 깨짐
}

datasource db {
  provider = "postgresql"
}

// 메시지 역할 — @companion/types 의 ChatRoleType('user'|'assistant')과 일치
enum Role {
  user
  assistant
}

// 로그인 사용자 (loginId/passwordHash 기반 인증)
model User {
  id           String   @id @default(cuid())
  loginId      String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  character     Character? // 1:1 — 유저당 캐릭터 하나
  conversations Conversation[]
  memories      Memory[]
  refreshSessions RefreshSession[]
}

// 리프레시 세션 — access token 재발급의 근거. 로그인/기기마다 1개.
// 토큰 원문은 저장하지 않고 sha256 해시만 저장한다(DB 유출 시 원문 복원 방지).
// 로그아웃 = 해당 row 삭제(폐기). refresh 회전 시 옛 row 삭제 + 새 row 생성.
model RefreshSession {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique // sha256(refreshToken) — 조회용이라 유니크·인덱스
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// 유저의 단 하나뿐인 컴패니언 (선택 목록이 아님)
// model(LLM)은 캐릭터 데이터가 아님 — 관리자 소유로 env(LLM_MODEL)에서 온다.
model Character {
  id     String @id @default(cuid())
  userId String @unique // @unique 가 1:1 + 인덱스를 함께 보장
  name   String // 사용자가 짓고 수정 가능
  // 캐릭터는 "조언자 톤"으로 축소됐다(제품 방향: 의사결정 컴패니언, 루트 README).
  // 남는 설정은 말투·호칭뿐이고, 이 둘이 서버가 시스템 프롬프트(instruction)를 조립하는 재료다(저장 안 함).
  // speechStyle 은 안정적 enum 키('casual' 등)라 DB enum 대신 String + 앱(DTO @IsIn) 검증. 값→라벨은 persona.ts 소유.
  // DB 상 nullable 이지만(마이그레이션 안전) 신규 생성은 DTO 에서 필수 필드를 강제한다.
  speechStyle  String? // 'casual'(반말) | 'formal'(존댓말) | 'semiformal'(반존대)
  userNickname String? // 캐릭터가 사용자를 부르는 호칭 (선택, 예: '오빠', '○○님')
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // 유저 관심사는 여기 저장하지 않는다 — 생성 시 category=INTEREST Memory row 로 시드해
  // 기존 recall 주입/표시 파이프라인을 그대로 탄다("나를 기억하는 AI"의 첫 기억).

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversations Conversation[]
}

// 대화 세션.
// 유저↔캐릭터가 1:1이라 characterId는 userId로 결정되는 중복이지만, 멀티 캐릭터 확장 대비로 유지.
// (DB가 "그 캐릭터가 그 유저 것"임을 강제하진 않으므로, 앱이 항상 유저의 캐릭터로 채워야 한다.)
model Conversation {
  id          String   @id @default(cuid())
  userId      String
  characterId String
  title       String?
  // 상품 검색 페이징 커서(대화 단위) — "다음/다른 상품" 요청 시 이어서 검색하기 위한 상태.
  // { keywords, category?, priceMin?, priceMax?, nextStart, hasMore }. 없으면 아직 검색 안 함.
  lastSearch  Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  messages  Message[]

  @@index([userId])
  @@index([characterId])
}

// 대화 속 개별 메시지
model Message {
  id             String   @id @default(cuid())
  conversationId String
  role           Role
  content        String
  // 상품추천 답변일 때 검색된 ProductType[] 스냅샷 (그 시점 가격·정보 박제, 카드 렌더용). 없으면 null.
  products       Json?
  // 이 검색에 이어볼 상품이 더 있는지(= 그 시점 커서의 hasMore). products 있을 때만 세팅. "더보기" 버튼 노출 판단용.
  hasMoreProducts Boolean?
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt]) // 대화별 메시지를 시간순으로 조회
}

// 장기 메모리 분류 — "AI가 기억하는 나" 페이지에서 카테고리별로 묶어 보여준다.
// 추출 LLM이 각 사실에 대해 가장 잘 맞는 하나를 고른다 (ETC는 fallback).
// 구매 의사결정에 실제로 쓰이는 기억만 담는다(루트 README). "사람에 묶이는" 지속 정보만 —
// 특정 상품에만 성립하는 일회성 조건("이번 선풍기는 저소음/5만원")은 추출 단계에서 걸러진다.
enum MemoryCategory {
  PREFERENCE // 선호 (브랜드·제품·스타일, 소비 성향 — 여러 결정에 두루 적용)
  PROFILE // 프로필·성향 (자취·전공·신체특성·성격·의사결정 스타일 등 지속 사실)
  OWNERSHIP // 보유·이력 (지금 쓰는/가진 것, 구매 이력 — 재추천 방지·생태계 근거)
  ETC // 기타
}

// 대화에서 추출한 장기 메모리 (MVP1: ~5개, 벡터 검색 아직 불필요)
model Memory {
  id         String         @id @default(cuid())
  userId     String
  category   MemoryCategory @default(ETC)
  content    String // 짧고 읽을 수 있는 사실 1개. 주입(프롬프트)+표시 겸용. 예: "밤에 공부하는 편"
  importance Int            @default(1)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
