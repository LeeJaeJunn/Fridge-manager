// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma" // src 안에 둬야 nest build 의 dist 구조가 안 깨짐
  moduleFormat = "cjs" // NestJS는 CommonJS — 기본 ESM(import.meta) 출력은 컴파일 깨짐
}

datasource db {
  provider = "postgresql"
}

// 메시지 역할 — @companion/types 의 ChatRoleType('user'|'assistant')과 일치
enum Role {
  user
  assistant
}

// 로그인 사용자 (loginId/passwordHash 기반 인증)
model User {
  id           String   @id @default(cuid())
  loginId      String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  character     Character? // 1:1 — 유저당 캐릭터 하나
  conversations Conversation[]
  memories      Memory[]
  inventory     Ingredient[] // 냉장고 재고
  refreshSessions RefreshSession[]
}

// 리프레시 세션 — access token 재발급의 근거. 로그인/기기마다 1개.
// 토큰 원문은 저장하지 않고 sha256 해시만 저장한다(DB 유출 시 원문 복원 방지).
// 로그아웃 = 해당 row 삭제(폐기). refresh 회전 시 옛 row 삭제 + 새 row 생성.
model RefreshSession {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique // sha256(refreshToken) — 조회용이라 유니크·인덱스
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// 유저의 단 하나뿐인 컴패니언 (선택 목록이 아님)
// model(LLM)은 캐릭터 데이터가 아님 — 관리자 소유로 env(LLM_MODEL)에서 온다.
model Character {
  id     String @id @default(cuid())
  userId String @unique // @unique 가 1:1 + 인덱스를 함께 보장
  name   String // 사용자가 짓고 수정 가능
  // 캐릭터는 "조언자 톤"으로 축소됐다(제품 방향: 의사결정 컴패니언, 루트 README).
  // 남는 설정은 말투·호칭뿐이고, 이 둘이 서버가 시스템 프롬프트(instruction)를 조립하는 재료다(저장 안 함).
  // speechStyle 은 안정적 enum 키('casual' 등)라 DB enum 대신 String + 앱(DTO @IsIn) 검증. 값→라벨은 persona.ts 소유.
  // DB 상 nullable 이지만(마이그레이션 안전) 신규 생성은 DTO 에서 필수 필드를 강제한다.
  speechStyle  String? // 'casual'(반말) | 'formal'(존댓말) | 'semiformal'(반존대)
  userNickname String? // 캐릭터가 사용자를 부르는 호칭 (선택, 예: '오빠', '○○님')
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // 유저 관심사는 여기 저장하지 않는다 — 생성 시 category=INTEREST Memory row 로 시드해
  // 기존 recall 주입/표시 파이프라인을 그대로 탄다("나를 기억하는 AI"의 첫 기억).

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversations Conversation[]
}

// 대화 세션.
// 유저↔캐릭터가 1:1이라 characterId는 userId로 결정되는 중복이지만, 멀티 캐릭터 확장 대비로 유지.
// (DB가 "그 캐릭터가 그 유저 것"임을 강제하진 않으므로, 앱이 항상 유저의 캐릭터로 채워야 한다.)
model Conversation {
  id          String   @id @default(cuid())
  userId      String
  characterId String
  title       String?
  // 상품 검색 페이징 커서(대화 단위) — "다음/다른 상품" 요청 시 이어서 검색하기 위한 상태.
  // { keywords, category?, priceMin?, priceMax?, nextStart, hasMore }. 없으면 아직 검색 안 함.
  lastSearch  Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  messages  Message[]

  @@index([userId])
  @@index([characterId])
}

// 대화 속 개별 아이템의 종류. OpenAI Responses 의 input/output 아이템 타입을 그대로 따른다
// (Gemini 는 function_result 라 부르지만, 이름 차이는 provider 안에서 흡수한다).
// 툴이 늘어도 컬럼이 늘지 않게 하려는 게 요점 — 툴별 내용은 전부 payload(Json) 안에 들어간다.
enum MessageItemType {
  TEXT // 사람이 읽는 말풍선 (role + content 사용)
  FUNCTION_CALL // 모델이 부른 툴 (payload 사용)
  FUNCTION_CALL_OUTPUT // 그 툴의 실행 결과 (payload 사용)
}

// 대화 속 개별 아이템 — 말풍선뿐 아니라 툴 호출·결과까지 **같은 테이블에 시간순**으로 쌓는다.
// LLM 에 보낼 때 이 행들을 그대로 벤더 아이템으로 되살리므로(= 재생), 히스토리가 벤더가 의도한
// 모양 그대로 유지된다. 예전처럼 "반영했어요" 같은 텍스트로 툴 결과를 흉내내지 않는다.
model Message {
  id             String          @id @default(cuid())
  conversationId String
  type           MessageItemType
  // 아래 둘은 TEXT 일 때만 채운다. function_call/function_call_output 아이템엔 role 개념이 없다.
  role           Role?
  content        String?
  // FUNCTION_CALL: { callId, name, arguments, resolved? } — arguments 는 파싱된 객체,
  //   resolved 는 서버가 카드용으로 가공한 값(예: 이름→ingredientId). 벤더로 보낼 땐 provider 가 재조립.
  // FUNCTION_CALL_OUTPUT: { callId, name, output } — name 은 Gemini 의 function_result 가 요구해서 담는다.
  payload        Json?
  createdAt      DateTime        @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt]) // 대화별 아이템을 시간순으로 조회
}

// 장기 메모리 분류 — "AI가 기억하는 나" 페이지에서 카테고리별로 묶어 보여준다.
// 추출 LLM이 각 사실에 대해 가장 잘 맞는 하나를 고른다 (ETC는 fallback).
// 구매 의사결정에 실제로 쓰이는 기억만 담는다(루트 README). "사람에 묶이는" 지속 정보만 —
// 특정 상품에만 성립하는 일회성 조건("이번 선풍기는 저소음/5만원")은 추출 단계에서 걸러진다.
enum MemoryCategory {
  // 먹으면 안 되는 것 (알레르기·못 먹는 재료). **안전 정보라 별도 카테고리다** —
  // 예전엔 PROFILE 에 문장으로 저장하고 내용을 정규식으로 훑어 골라냈는데,
  // 안전 판별을 문자열 추측에 맡기는 구조였다. content 에는 **재료·분류 이름만** 담는다("오이", "갑각류").
  ALLERGY
  PREFERENCE // 식성 (매운거 좋아함, 오이 싫어함, 채식 등)
  PROFILE // 프로필·성향 (요리 실력, 1인 가구, 자취 등)
  OWNERSHIP // 조리도구, 주방 환경 (에어프라이어, 인덕션 등)
  ETC // 기타
}

// 대화에서 추출한 장기 메모리 (MVP1: ~5개, 벡터 검색 아직 불필요)
model Memory {
  id         String         @id @default(cuid())
  userId     String
  category   MemoryCategory @default(ETC)
  content    String // 짧고 읽을 수 있는 사실 1개. 주입(프롬프트)+표시 겸용. 예: "밤에 공부하는 편"
  importance Int            @default(1)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// 보관 위치 — 소비기한 추정에 영향을 준다(같은 재료도 냉동이 가장 길다).
enum StorageArea {
  FRIDGE // 냉장
  FREEZER // 냉동
  PANTRY // 실온·찬장
}

// expiresAt 의 출처. 사용자가 알려준 표기일(USER)은 신뢰하고, 추정치(ESTIMATED)는 참고로만 보여준다.
// UI 가 "8/12까지" 와 "8/12쯤" 을 가르는 근거.
enum ExpirySource {
  USER
  ESTIMATED
}

// 재료 분류 — 소비기한 추정 기준 + 냉장고 화면 그룹핑.
enum IngredientCategory {
  VEGETABLE // 채소
  FRUIT // 과일
  MEAT // 육류
  SEAFOOD // 해산물
  DAIRY // 유제품
  EGG // 달걀
  GRAIN // 곡물·면·빵
  SAUCE // 양념·소스
  PROCESSED // 가공식품·통조림
  FROZEN // 냉동식품
  ETC // 기타
}

// 냉장고 재고 한 건. 이 앱에서 "기억"이 장식이 아니라 필수가 되는 지점 —
// 상태가 계속 변하므로 앱이 들고 있지 않으면 기능 자체가 성립하지 않는다.
//
// 쿼리가 필요한 것만 구조화한다: name(레시피 매칭)·expiresAt(임박 정렬)·consumedAt(소비 여부).
// 수량은 quantityNote 자유텍스트 — 앱은 실제 소비를 관찰하지 못해서(김치찌개 하나에 대파가
// 몇 단 줄었는지 알 수 없다) 숫자를 들고 있어도 금방 허구가 되고, 틀린 숫자는 신뢰를 깎는다.
model Ingredient {
  id           String             @id @default(cuid())
  userId       String
  name         String // 정규화된 재료명 "계란" — 레시피 매칭·중복 판정 키
  category     IngredientCategory @default(ETC)
  quantityNote String? // "한 판", "반 팩", "개봉함" — 표시 전용, 계산하지 않는다
  storage      StorageArea        @default(FRIDGE)
  addedAt      DateTime           @default(now()) // 등록(구입) 시점 — 추정의 기준점
  // 항상 채운다(nullable 아님). 유저가 알려주면 그 값, 모르면 카테고리×보관위치 추정치.
  // 읽을 때 분기하면 "곧 상하는 것" 조회·정렬하는 모든 경로가 분기를 떠안으므로 쓸 때 폴백한다.
  expiresAt    DateTime
  expirySource ExpirySource       @default(ESTIMATED)
  // soft delete — LLM 이 잘못 차감했을 때 되돌리기가 UPDATE 한 번이고, 나중에 "자주 사는 재료" 근거가 된다.
  consumedAt   DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, consumedAt, expiresAt]) // "안 먹은 것 중 임박순" 을 단일 인덱스로 커버
}
