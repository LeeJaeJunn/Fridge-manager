// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma" // src 안에 둬야 nest build 의 dist 구조가 안 깨짐
  moduleFormat = "cjs" // NestJS는 CommonJS — 기본 ESM(import.meta) 출력은 컴파일 깨짐
}

datasource db {
  provider = "postgresql"
}

// 메시지 역할 — @companion/types 의 ChatRoleType('user'|'assistant')과 일치
enum Role {
  user
  assistant
}

// 로그인 사용자.
//
// **로그인 수단은 여기 없다** — `AuthIdentity` 가 1:N 으로 들고 있다(그 모델 주석 참고).
// 여기 남는 건 "사람"에 대한 것뿐이다: 누구인지(email·name)와 비밀번호(이메일 가입자만).
model User {
  id            String    @id @default(cuid())
  // 로그인 키 겸 연락처. 예전 `loginId`(임의 문자열)를 대체한다.
  //
  // **인증 수단이 아니라 "사람 동일성"의 축이라 필수(NOT NULL)다.** 카카오 id 와 구글 id 는
  // 서로 아무 관계가 없어서, 이메일이 없으면 같은 사람이 두 수단으로 로그인했을 때 동일인인지
  // 알 방법이 전혀 없다 → 계정이 갈라지고 재고가 한쪽에만 쌓인다(이 앱에선 치명적).
  // 결제 연락처(영수증·결제 실패·만료 안내)이기도 하다.
  // nullable 로 두면 이메일을 쓰는 모든 경로가 null 분기를 떠안으므로, 쓸 때 보장한다
  // (`Ingredient.expiresAt` 과 같은 판단) — 소셜이 이메일을 안 주면 **가입을 거부**한다.
  // ⚠️ 애플의 Private Relay 주소는 앱마다 달라 다른 provider 의 이메일과 절대 일치하지 않는다.
  //    그래서 애플 유저의 동일인 판정은 이메일로 안 되고, 명시적 "계정 연결"이 답이다.
  email         String    @unique
  // 인증 시각. null = 미인증. 지금은 미인증도 로그인 가능하고, 결제를 붙일 때 여기를 요구한다.
  // 소셜은 provider 가 검증한 이메일만 받으므로 가입 시점에 채운다.
  emailVerified DateTime?
  // 이메일 가입자만 갖는다. 소셜 전용 유저는 null.
  // ⚠️ 비밀번호는 **여기 한 곳**이다 — `AuthIdentity` 에 두지 않는다. 참고한 프로젝트가 양쪽에
  // 두고 한쪽이 죽은 컬럼이 돼 있었는데, 두 기록이 어긋나는 전형적인 모양이다.
  passwordHash  String?
  name          String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  character       Character? // 1:1 — 유저당 캐릭터 하나
  conversations   Conversation[]
  memories        Memory[]
  inventory       Ingredient[] // 냉장고 재고
  refreshSessions RefreshSession[]
  identities      AuthIdentity[] // 로그인 수단 (LOCAL/KAKAO/…)
  // ⚠️ 유일하게 cascade 가 **아닌** 관계다 — 탈퇴해도 원장은 남고 userId 만 끊긴다(LlmUsage 주석 참고).
  llmUsage        LlmUsage[]
}

// 로그인 수단 한 개 = 행 한 개. **"이 사람이 어느 문으로 들어오는가."**
//
// 한 유저가 수단을 **여러 개** 가질 수 있어서 별도 테이블이다(카카오로 가입했다가 나중에 구글을
// 연결). `User` 에 provider 컬럼을 박으면 문이 하나뿐이라 두 번째에서 막히고, iOS 심사 때문에
// 애플을 붙이는 순간 실제로 그 상황이 온다. `RefreshSession` 이 별도 테이블인 것과 같은 1:N 이다.
//
// 로그인 흐름: 카카오가 "이 사람 3820156789번" 이라고 알려주면 `(provider, providerUserId)` 로
// 이 표를 찾아 `userId` 를 얻는다 — **저쪽 번호 → 우리 번호 번역표**다.
// ⚠️ 이메일이 아니라 `providerUserId` 가 키인 이유: 이메일은 바뀐다. 그쪽 회원번호는 안 바뀐다.
model AuthIdentity {
  id             String   @id @default(cuid())
  userId         String
  // 'LOCAL' | 'KAKAO' | 'NAVER' | 'GOOGLE' (나중에 'APPLE').
  // ⚠️ DB enum 이 아니라 String 이다 — `speechStyle` 과 같은 판단이고, Prisma 생성 enum 을
  // `===` 로 비교하면 no-unsafe-enum-comparison 이 걸린다. 덤으로 provider 추가에 마이그레이션이
  // 필요 없다. 값 목록의 단일 출처는 코드 상수(`PROVIDER_VALUES`)이고 DTO 검증도 거기서 쓴다.
  provider       String
  // 그쪽 서비스가 그 사람에게 붙인 안정적 식별자. **LOCAL 은 외부 서비스가 없어서 null**
  // (그 유저의 비밀번호는 `User.passwordHash` 에 있다).
  providerUserId String?
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // 한 소셜 계정이 두 유저에 붙는 것 방지. **번호만으론 부족하다** — 카카오 123 과 구글 123 은
  // 우연히 둘 다 존재할 수 있고 서로 다른 사람이라, 열쇠는 두 컬럼의 짝이다.
  @@unique([provider, providerUserId])
  // 한 유저에게 같은 provider 가 두 번 붙는 것 방지 (LOCAL 이 두 줄 생기는 것도 여기서 막힌다).
  @@unique([userId, provider])
  @@index([userId])
}

// 리프레시 세션 — access token 재발급의 근거. 로그인/기기마다 1개.
// 토큰 원문은 저장하지 않고 sha256 해시만 저장한다(DB 유출 시 원문 복원 방지).
// 로그아웃 = 해당 row 삭제(폐기). refresh 회전 시 옛 row 삭제 + 새 row 생성.
model RefreshSession {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique // sha256(refreshToken) — 조회용이라 유니크·인덱스
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// 이메일 인증 한 건의 **상태**. 한 행 = "코드를 한 번 발급한 사건"이고, 발급→시도→인증→소비까지
// 살아 있다가 지워진다. 발송 로그가 아니라 계속 바뀌는 상태다.
//
// **`User` 와 관계를 걸지 않는다** — 가입 *전에* 존재해야 해서 매달 유저가 없다.
//
// 왜 테이블이 필요한가: 서버가 "이 주소에 어떤 코드를 보냈는지" 기억하지 못하면 대조 자체가
// 불가능하다. 메모리에 두면 watch 재시작마다 날아가고(개발이 안 된다) 서버가 2대가 되면 성립하지
// 않는다. 그리고 6자리 숫자는 **시도 제한이 없으면 뚫린다** — 100만 조합이라 초당 수백 번이면
// 10분 창 안에 유의미한 확률이 나오고, 재발급을 반복하면 계속 누적된다. `failCount` 가 그걸
// 100만분의 5로 만든다. `@nestjs/throttler` 가 붙기 전까지는 **이게 유일한 무차별 대입 방어**다.
//
// 컬럼이 각각 방어 질문 하나에 답한다:
//   expiresAt  = 아직 유효한가          failCount = 몇 번 틀렸나(5회 잠금)
//   createdAt  = 언제 보냈나(쿨다운·시간당 상한)
//   verifiedAt = 인증에 성공했나        tokenHash = 그 인증을 통과한 클라이언트가 맞는가
model EmailVerification {
  id         String    @id @default(cuid())
  email      String
  // 'SIGNUP' (앞으로 'RESET_PASSWORD' | 'CHANGE_EMAIL'). 가입용 코드로 비밀번호를 바꾸지
  // 못하게 용도를 갈라 둔다. provider 와 같은 이유로 DB enum 이 아니라 String 이다.
  purpose    String
  // sha256(6자리 코드). ⚠️ 솔직히 6자리는 해시의 방어력이 약하다(오프라인이면 즉시 크랙).
  // 진짜 방어는 failCount + expiresAt 이고, 이건 로그·덤프에 코드가 그대로 남지 않게 하는 정도다.
  codeHash   String
  expiresAt  DateTime
  verifiedAt DateTime?
  failCount  Int       @default(0)
  // 인증 성공 시 발급하는 증표. **가입 단계와 인증 단계를 잇는 유일한 끈**이다 —
  // 이게 없으면 verifiedAt 만 보고 가입시키게 되는데, 그러면 코드를 못 본 제3자도
  // "이미 인증된 이메일"에 얹혀 가입할 수 있다. nullable 이지만 Postgres 는 NULL 중복을
  // 허용하므로 미인증 행끼리 유니크 제약에 걸리지 않는다(User.email 과 같은 방식).
  tokenHash  String?   @unique
  createdAt  DateTime  @default(now())

  // 최신 행 조회(검증·쿨다운) + 최근 1시간 카운트(시간당 상한) + 정리를 한 인덱스로 커버
  @@index([email, purpose, createdAt])
}

// 유저의 단 하나뿐인 컴패니언 (선택 목록이 아님)
// model(LLM)은 캐릭터 데이터가 아님 — 관리자 소유로 env(LLM_MODEL)에서 온다.
model Character {
  id          String   @id @default(cuid())
  userId      String   @unique // @unique 가 1:1 + 인덱스를 함께 보장
  name        String // 사용자가 짓고 수정 가능
  // 캐릭터는 "조언자 톤"으로 축소됐다(제품 방향: 의사결정 컴패니언, 루트 README).
  // 남는 설정은 **말투 하나**이고, 그게 서버가 시스템 프롬프트(instruction)를 조립하는 재료다(저장 안 함).
  // speechStyle 은 안정적 enum 키('casual' 등)라 DB enum 대신 String + 앱(DTO @IsIn) 검증. 값→라벨은 persona.ts 소유.
  // DB 상 nullable 이지만(마이그레이션 안전) 신규 생성은 DTO 에서 필수 필드를 강제한다.
  //
  // `userNickname`(캐릭터가 사용자를 부르는 호칭)은 걷어냈다. 이름스러운 값이 셋(캐릭터 이름 ·
  // 내 이름 · 호칭)이라 유저가 헷갈렸고, 사용자를 부르는 말은 `User.name` 하나면 된다.
  // 소셜 로그인이 이름을 주므로 그쪽은 자동으로 채워지고, 결제·시스템 메일에도 쓸 수 있다
  // (호칭은 "오빠" 같은 값이라 메일에 못 쓴다).
  speechStyle String? // 'casual'(반말) | 'formal'(존댓말) | 'semiformal'(반존대)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // 온보딩 태그(식성·알레르기·조리도구)는 여기 저장하지 않는다 — 캐릭터가 아니라 **유저 정보**라
  // 생성 시 Memory row 로 시드해 기존 recall 주입/표시 파이프라인을 그대로 탄다.
  // 그룹마다 카테고리가 다르다: 식성→PREFERENCE / 알레르기→ALLERGY / 조리도구→OWNERSHIP (persona.ts 소유).

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversations Conversation[]
}

// 대화 세션.
// 유저↔캐릭터가 1:1이라 characterId는 userId로 결정되는 중복이지만, 멀티 캐릭터 확장 대비로 유지.
// (DB가 "그 캐릭터가 그 유저 것"임을 강제하진 않으므로, 앱이 항상 유저의 캐릭터로 채워야 한다.)
model Conversation {
  id          String   @id @default(cuid())
  userId      String
  characterId String
  title       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  messages  Message[]

  @@index([userId])
  @@index([characterId])
}

// 대화 속 개별 아이템의 종류. OpenAI Responses 의 input/output 아이템 타입을 그대로 따른다
// (Gemini 는 function_result 라 부르지만, 이름 차이는 provider 안에서 흡수한다).
// 툴이 늘어도 컬럼이 늘지 않게 하려는 게 요점 — 툴별 내용은 전부 payload(Json) 안에 들어간다.
enum MessageItemType {
  TEXT // 사람이 읽는 말풍선 (role + content 사용)
  FUNCTION_CALL // 모델이 부른 툴 (payload 사용)
  FUNCTION_CALL_OUTPUT // 그 툴의 실행 결과 (payload 사용)
}

// 대화 속 개별 아이템 — 말풍선뿐 아니라 툴 호출·결과까지 **같은 테이블에 시간순**으로 쌓는다.
// LLM 에 보낼 때 이 행들을 그대로 벤더 아이템으로 되살리므로(= 재생), 히스토리가 벤더가 의도한
// 모양 그대로 유지된다. 예전처럼 "반영했어요" 같은 텍스트로 툴 결과를 흉내내지 않는다.
model Message {
  id             String          @id @default(cuid())
  conversationId String
  type           MessageItemType
  // 아래 둘은 TEXT 일 때만 채운다. function_call/function_call_output 아이템엔 role 개념이 없다.
  role           Role?
  content        String?
  // FUNCTION_CALL: { callId, name, arguments, resolved? } — arguments 는 파싱된 객체,
  //   resolved 는 서버가 카드용으로 가공한 값(예: 이름→ingredientId). 벤더로 보낼 땐 provider 가 재조립.
  // FUNCTION_CALL_OUTPUT: { callId, name, output } — name 은 Gemini 의 function_result 가 요구해서 담는다.
  payload        Json?
  createdAt      DateTime        @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt]) // 대화별 아이템을 시간순으로 조회
}

// 장기 메모리 분류 — "AI가 기억하는 나" 페이지에서 카테고리별로 묶어 보여준다.
// 추출 LLM이 각 사실에 대해 가장 잘 맞는 하나를 고른다 (ETC는 fallback).
enum MemoryCategory {
  ALLERGY
  PREFERENCE // 식성 (매운거 좋아함, 오이 싫어함, 채식 등)
  PROFILE // 프로필·성향 (요리 실력, 1인 가구, 자취 등)
  OWNERSHIP // 조리도구, 주방 환경 (에어프라이어, 인덕션 등)
  ETC // 기타
}

// 대화에서 추출한 장기 메모리 (MVP1: ~5개, 벡터 검색 아직 불필요)
//
// importance(1~3) 컬럼이 있었는데 걷어냈다. 무게를 카테고리가 이미 지고 있어서다 —
// 프롬프트가 category 로 섹션을 가르고(splitMemories) 각 섹션을 **전부** 렌더하므로,
// 알레르기가 묻히지 않는 건 "중요도 3" 이 아니라 "전용 블록이 맨 끝에 온다" 가 보장한다.
// 정렬에만 쓰이면서 추출 LLM 이 매번 값을 지어내야 하는 필드였다.
model Memory {
  id        String         @id @default(cuid())
  userId    String
  category  MemoryCategory @default(ETC)
  content   String // 짧고 읽을 수 있는 사실 1개. 주입(프롬프트)+표시 겸용. 예: "밤에 공부하는 편"
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// 보관 위치 — 소비기한 추정에 영향을 준다(같은 재료도 냉동이 가장 길다).
enum StorageArea {
  FRIDGE // 냉장
  FREEZER // 냉동
  PANTRY // 실온·찬장
}

// expiresAt 이 **어떻게 정해졌는지**.
//   USER      = 사용자가 날짜를 직접 골랐다
//   ESTIMATED = 사용자가 "기본값"을 선택해서 카테고리×보관위치 추정치가 들어갔다
//   NONE      = 아무것도 안 정했다 (expiresAt 은 null)
//
// ⚠️ **화면은 이 값을 읽지 않는다.** 예전엔 "8/12까지" vs "8/12쯤" 을 가르는 데 썼는데,
// 이제 날짜는 사용자가 넣기로 한 것만 있으므로 표기를 흐릴 이유가 없다.
// 남겨두는 건 **"사람들이 유통기한을 실제로 넣는가"를 나중에 재기 위한 기록**이다
// (넣는다면 직접 고르는지 기본값에 맡기는지도 함께). 안 읽힌다고 죽은 컬럼으로 보고 지우지 말 것.
enum ExpirySource {
  USER
  ESTIMATED
  NONE
}

// 재료 분류 — 소비기한 추정 기준 + 냉장고 화면 그룹핑.
enum IngredientCategory {
  VEGETABLE // 채소
  FRUIT // 과일
  MEAT // 육류
  SEAFOOD // 해산물
  DAIRY // 유제품
  EGG // 달걀
  GRAIN // 곡물·면·빵
  SAUCE // 양념·소스
  PROCESSED // 가공식품·통조림
  FROZEN // 냉동식품
  ETC // 기타
}

// 냉장고 재고 한 건. 이 앱에서 "기억"이 장식이 아니라 필수가 되는 지점 —
// 상태가 계속 변하므로 앱이 들고 있지 않으면 기능 자체가 성립하지 않는다.
//
// 쿼리가 필요한 것만 구조화한다: name(레시피 매칭)·expiresAt(임박 정렬)·consumedAt(소비 여부).
// 수량은 quantityNote 자유텍스트 — 앱은 실제 소비를 관찰하지 못해서(김치찌개 하나에 대파가
// 몇 단 줄었는지 알 수 없다) 숫자를 들고 있어도 금방 허구가 되고, 틀린 숫자는 신뢰를 깎는다.
model Ingredient {
  id           String             @id @default(cuid())
  userId       String
  name         String // 정규화된 재료명 "계란" — 레시피 매칭·중복 판정 키
  category     IngredientCategory @default(ETC)
  quantityNote String? // "한 판", "반 팩", "개봉함" — 표시 전용, 계산하지 않는다
  storage      StorageArea        @default(FRIDGE)
  addedAt      DateTime           @default(now()) // 등록(구입) 시점 — 추정의 기준점
  // **null = 미설정이고, 그게 기본값이다.** 서버가 추정해서 자동으로 채우지 않는다.
  //
  // 예전엔 항상 채웠다(모르면 카테고리×보관위치 추정치). 조회·정렬 경로가 null 분기를 안 떠안게
  // 하려는 거였는데, 대가로 **우리가 지어낸 날짜가 화면에서 확정값과 구분되지 않았다.**
  // 추정은 대체로 틀리고, 사용자는 사실 더 잘 알면서 입력이 귀찮아 안 넣을 뿐이다.
  // 그래서 비워두고, 넣기로 한 것만 값이 생긴다(직접 고르거나 "기본값"을 선택하거나).
  //
  // 정렬·조회는 Postgres 기본 동작이 그대로 원하는 모양이라 거의 안 바뀌었다:
  // `ORDER BY expiresAt ASC` 는 NULL 을 맨 뒤로 보내고(임박순에서 미설정이 아래),
  // `expiresAt <= :until` 은 NULL 을 자동으로 제외한다("먼저 먹어요"에서 빠진다).
  expiresAt    DateTime?
  // ⚠️ expiresAt 과 **짝이다** — 날짜를 쓰는 곳에서 반드시 함께 쓴다. 따로 쓰면 두 기록이 어긋난다.
  expirySource ExpirySource       @default(NONE)
  // soft delete — LLM 이 잘못 차감했을 때 되돌리기가 UPDATE 한 번이고, 나중에 "자주 사는 재료" 근거가 된다.
  consumedAt   DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, consumedAt, expiresAt]) // "안 먹은 것 중 임박순" 을 단일 인덱스로 커버
}

// LLM 호출 원장 — 호출 1건 = 행 1개. **append-only, 절대 수정하지 않는다**(집계는 여기서 파생).
// 지금은 제한이 없고 **계측만** 한다. 구독제를 붙일 때 무료 한도를 얼마로 둘지는 추측이 아니라
// 이 데이터의 분포를 보고 정한다(한도는 올리긴 쉽고 내리긴 최악이라 먼저 재고 나중에 막는다).
//
// ⚠️ **원장 행은 userId 로도 conversationId 로도 지워지지 않는다.** 돈은 이미 썼고, 유저가
// 대화를 지우거나 탈퇴한다고 그 지출이 없던 일이 되지 않는다. 지난달 결산을 뽑아둔 뒤 누가
// 탈퇴했다고 지난달 총액이 줄어들면 그건 원장이 아니다. 그래서:
//   - conversationId 는 FK 를 아예 안 건다 (매달린 id 가 되는 게 정상 — 영수증은 없어진 가게도 가리킨다)
//   - userId 는 SetNull 이다 (이 레포에서 유일하게 cascade 가 아닌 관계)
//
// 탈퇴 시 SetNull 이 프라이버시도 만족한다: 이 표엔 **대화 내용이 없고**(토큰 수·모델명·시각뿐)
// 사람과 잇는 유일한 끈이 userId 라, 그걸 끊으면 남는 건 돌아갈 곳 없는 cuid 다 = 재연결 불가.
// 행을 지우는 대신 익명화하는 셈이고, 덕분에 과거 원가 집계가 영원히 안 흔들린다.
model LlmUsage {
  id             String   @id @default(cuid())
  // nullable = 탈퇴한 유저의 행. 쿼터 조회(`where: { userId }`)는 자연히 이 행들을 안 잡는다.
  userId         String?
  // FK 가 아니다(위 참고). 대화가 지워져도 남는 디버깅용 참조이고, scan 처럼 대화 밖이면 null.
  // 이 앱은 매 턴 히스토리를 통째로 재생하므로 "긴 대화가 실제로 얼마나 비싼가"를 곧 묻게 되는데,
  // 이 값이 없으면 물어볼 방법이 없다. 그리고 안 남긴 건 나중에 복구가 안 된다.
  conversationId String?
  feature        String // 'chat' | 'memory_extract' | 'scan' | 'consume_calc' — 원가를 기능별로 가른다
  model          String // 모델을 바꾸면 같은 행동도 토큰이 달라져 함께 남긴다
  inputTokens    Int
  outputTokens   Int
  // 벤더가 준 값을 그대로 담는다 — 우리가 input+output 을 더한 게 아니다.
  // 둘이 항상 같다는 보장이 없고(추론·캐시 토큰 등), 어긋나면 벤더 값이 진실이다.
  totalTokens    Int
  // 유저 쿼터에 셀지. 원가(전부)와 쿼터(유저가 시킨 것만)는 **다른 질문**이라 컬럼으로 가른다.
  // false 인 것: 백그라운드 메모리 추출(유저가 시킨 적 없다), 우리 쪽 오류로 인한 재호출.
  // ⚠️ feature 에서 파생하지 않는다 — 같은 'chat' 인데 billable 이 갈리는 경우가 있어서 재구성이 안 된다.
  // ⚠️ @default 를 일부러 안 준다 — 새 호출 지점을 추가할 때 "이건 유저가 시킨 건가?"를 반드시 답하게.
  billable       Boolean
  createdAt      DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt]) // "이번 달 내 사용량" 을 단일 인덱스로 커버
}
